// --- I2C Helper Functions ---
void writeTo(byte address, byte val) {
  Wire.beginTransmission(ADXL_DEVICE);
  Wire.write(address);
  Wire.write(val);
  Wire.endTransmission();
}

void readFromADXL(byte address, int num, byte _buff[]) {
  Wire.beginTransmission(ADXL_DEVICE);
  Wire.write(address);
  Wire.endTransmission(false);
  Wire.requestFrom(ADXL_DEVICE, (uint8_t)num);
  int i = 0;
  while(Wire.available() && i < num) { _buff[i] = Wire.read(); i++; }
}

// TOF
bool readTofData() {
  tof0.dis = 0;
  tof0.signal_strength = 0;
  digitalWrite(PIN_VEXT_CTL, VEXT_ENABLE);
  setSensorPower(true);
  delay(1000);
  
  uint8_t pdata[48] = {0};

  // 1.
  Wire.beginTransmission(TOF_ADDR);
  Wire.write(0x00);
  if (Wire.endTransmission(false) != 0) {
      setSensorPower(false); 
      Serial.println("[TOF Error] Cannot communicate with TOF Sensor!");
      return false;
  }
  Wire.requestFrom((uint8_t)TOF_ADDR, (uint8_t)32);
  int i = 0; 
  while (Wire.available() && i < 32) pdata[i++] = Wire.read();

  // 2.
  Wire.beginTransmission(TOF_ADDR);
  Wire.write(0x20);
  if (Wire.endTransmission(false) != 0) {
      setSensorPower(false);
      return false;
  }
  Wire.requestFrom((uint8_t)TOF_ADDR, (uint8_t)16);
  while (Wire.available() && i < 48) pdata[i++] = Wire.read();

  // 3. แปลงค่าข้อมูล
  uint32_t raw_dis = ((uint32_t)pdata[0x24]) | 
                     ((uint32_t)pdata[0x25] << 8) | 
                     ((uint32_t)pdata[0x26] << 16) | 
                     ((uint32_t)pdata[0x27] << 24);
                     
  tof0.dis = (float)raw_dis / 1000.0f;
  tof0.signal_strength = (uint16_t)(((uint16_t)pdata[0x2a]) | ((uint16_t)pdata[0x2b] << 8));

  setSensorPower(false);
  return true;
}

// BATT
uint16_t readBattery() {
  float currentRead = analogRead(MY_BAT_ADC);
  adcValue = (currentRead * 0.1) + (adcValue * 0.9);
  float calculated_mv = (adcValue / ADC_MAX) * V_REF * MY_DIVIDER_FACTOR;
  return (uint16_t)calculated_mv;
}

// ===== Prepare LoRaWAN Payload (Total 28 Bytes) =====
void prepareTxFrame(uint8_t port) {

    if (!wdt_initialized) {
      initWatchdog(240); 
    }
    feedWatchdog();

    txCounter++;

    digitalWrite(PIN_VEXT_CTL, VEXT_ENABLE); 
    delay(200); 

    // 1. GPS
    // uint32_t waitGPS = millis();
    // while (millis() - waitGPS < 60000) {
    //   while (Serial2.available()) gps.encode(Serial2.read());
    // }

    // if (gps.location.isValid()) {
    //   latitude = gps.location.lat();
    //   longitude = gps.location.lng();
    // } else {
    //   latitude = 0; 
    //   longitude = 0;
    // }
    latitude = 0; 
    longitude = 0;

    // 2. ADXL345
    readFromADXL(0x32, 6, _buff_adxl); 
    int16_t x_real = (int16_t)((_buff_adxl[1] << 8) | _buff_adxl[0]);
    int16_t y_real = (int16_t)((_buff_adxl[3] << 8) | _buff_adxl[2]);
    int16_t z_real = (int16_t)((_buff_adxl[5] << 8) | _buff_adxl[4]);

    float ax = x_real / 128.0;
    float ay = y_real / 128.0;
    float az = z_real / 128.0;

    is_current_face_up = (z_real >= 0);

    float pitch_actual = atan2(ax, sqrt(ay * ay + az * az)) * 180.0 / M_PI;
    float roll_actual  = atan2(ay, sqrt(ax * ax + az * az)) * 180.0 / M_PI; 

    // --- Gyro config ---
    if (is_first_run) {
        pitch_base = -4.30; // ค่าดิบ Pitch
        roll_base  = -3.68;  // ค่าดิบ Roll
        is_base_face_up = is_current_face_up;
        is_first_run = false;
        
        Serial.printf("[Calibrate] ฟิกค่าศูนย์สำเร็จ! Pitch Base: %.1f, Roll Base: %.1f\n", pitch_base, roll_base);
    }

    pitch = pitch_actual - pitch_base;
    roll  = roll_actual - roll_base;

    if (roll > 180.0)  roll -= 360.0;
    if (roll < -180.0) roll += 360.0;
    if (pitch > 180.0) pitch -= 360.0;
    if (pitch < -180.0) pitch += 360.0;

    int16_t pitch_int = (int16_t)(pitch * 100);
    int16_t roll_int  = (int16_t)(roll * 100);

    uint8_t orientation_flag = 0;
    if (is_current_face_up) orientation_flag |= (1 << 0);
    if (is_base_face_up)    orientation_flag |= (1 << 1);

    // อ่านค่า TOF และ SHT31
    bool tofSuccess = readTofData();
    int32_t dis_mm = (int32_t)(tof0.dis * 1000);

    // temperature = sht31.readTemperature();
    // humidity = sht31.readHumidity();
    // if (isnan(temperature)) temperature = 0.0;
    // if (isnan(humidity)) humidity = 0.0;
    // int16_t temp_int = (int16_t)(temperature * 100);
    // int16_t humid_int = (int16_t)(humidity * 100);
    temperature = 0.0;
    humidity = 0.0;
    int16_t temp_int = 0;
    int16_t humid_int = 0;

    // อ่านค่า Batt
    batteryVoltage = readBattery(); 
    Serial.printf("Battery processed: %d mV\n", batteryVoltage);

    appDataSize = 28; 

    // // GPS
    // int32_t lat_int = (int32_t)(latitude * 1e6);
    // int32_t lon_int = (int32_t)(longitude * 1e6);

    // // [0-7] GPS Payload
    // appData[0] = (lat_int >> 24); appData[1] = (lat_int >> 16); appData[2] = (lat_int >> 8); appData[3] = lat_int;
    // appData[4] = (lon_int >> 24); appData[5] = (lon_int >> 16); appData[6] = (lon_int >> 8); appData[7] = lon_int;
    
    int32_t lat_int = 0;
    int32_t lon_int = 0;

    // [0-7] GPS Payload (ส่งค่า 0)
    appData[0] = 0; appData[1] = 0; appData[2] = 0; appData[3] = 0;
    appData[4] = 0; appData[5] = 0; appData[6] = 0; appData[7] = 0;

    // [8-13] ADXL345 Data 
    appData[8] = (pitch_int >> 8); appData[9] = pitch_int;   
    appData[10] = (roll_int >> 8); appData[11] = roll_int;  
    appData[12] = (z_real >> 8);   appData[13] = z_real;

    // [14-17] TOF Distance
    appData[14] = (dis_mm >> 24); appData[15] = (dis_mm >> 16); appData[16] = (dis_mm >> 8); appData[17] = dis_mm;

    // [18-19] TOF Signal Strength
    appData[18] = (tof0.signal_strength >> 8); appData[19] = tof0.signal_strength;

    // [20-21] Transmission Count
    appData[20] = (txCounter >> 8); appData[21] = txCounter;

    // [22-23] Battery Voltage
    appData[22] = (batteryVoltage >> 8); appData[23] = batteryVoltage;

    // // [24-25] SHT31 Temperature
    // appData[24] = (temp_int >> 8); appData[25] = temp_int;

    // // [26-27] SHT31 Humidity
    // appData[26] = (humid_int >> 8); appData[27] = humid_int;

    // [24-27] SHT31 Temp & Humid (ส่งค่า 0)
    appData[24] = 0; appData[25] = 0;
    appData[26] = 0; appData[27] = 0;

    // Serial Monitor
    Serial.printf("\n[TX #%d] Lat:%.6f, Lon:%.6f | Dist: %.3f m | Batt: %d mV | Temp: %.2f *C | Hum: %.2f %%\n", 
                  txCounter, latitude, longitude, (float)dis_mm/1000.0, batteryVoltage, temperature, humidity);
    Serial.printf("ADXL -> Pitch: %.2f deg, Roll: %.2f deg\n", pitch, roll);
    Serial.printf("STATUS -> ตอนเซ็ตศูนย์: %s | ปัจจุบัน: %s (Z-Raw: %d)\n",
                  is_base_face_up ? "หงาย" : "คว่ำ",
                  is_current_face_up ? "หงาย" : "คว่ำ", z_real);
}

void setup() {
  boardInit(LORA_DEBUG_ENABLE, LORA_DEBUG_SERIAL_NUM, 115200);
  analogReadResolution(12); 
  analogReference(AR_VDD4); 

  pinMode(PIN_POWER_CTL, OUTPUT); 
  setSensorPower(false);

  pinMode(PIN_VEXT_CTL, OUTPUT);
  digitalWrite(PIN_VEXT_CTL, HIGH);
  delay(500);

  Wire.setPins(29, 31);
  Wire.begin();
  //--- GPS
  //Serial2.begin(9600);

  //--- sht31
  // if (!sht31.begin(0x44)) {
  //   Serial.println("Couldn't find SHT31 Sensor!");
  // } else {
  //   Serial.println("SHT31 Sensor initialized.");
  // }

  writeTo(0x31, 0x01);
  writeTo(0x2D, 0x08);
  
  MibRequestConfirm_t mibReq;
  mibReq.Type = MIB_RX2_CHANNEL;
  mibReq.Param.Rx2Channel.Frequency = 923200000; 
  mibReq.Param.Rx2Channel.Datarate = DR_2;        
  LoRaMacMibSetRequestConfirm(&mibReq);
  Serial.println("[LoRaWAN] RX2 Frequency forced to 923.2 MHz (DR2)");
  adcValue = analogRead(MY_BAT_ADC);
  //Serial.println("Wait for GPS fix...");

  deviceState = DEVICE_STATE_INIT;
}

void loop() {
  //--- GPS
  //while (Serial2.available()) gps.encode(Serial2.read());

  switch (deviceState) {
    case DEVICE_STATE_INIT:
      LoRaWAN.init(loraWanClass, loraWanRegion);
      deviceState = DEVICE_STATE_JOIN;
      break;
    case DEVICE_STATE_JOIN:
      LoRaWAN.join();
      break;
    case DEVICE_STATE_SEND:
      prepareTxFrame(appPort);
      LoRaWAN.send();
      deviceState = DEVICE_STATE_CYCLE;
      break;
    case DEVICE_STATE_CYCLE:
      LoRaWAN.cycle(appTxDutyCycle);
      deviceState = DEVICE_STATE_SLEEP;
      break;
    case DEVICE_STATE_SLEEP:
      setSensorPower(false);
      LoRaWAN.sleep(loraWanClass);
      break;
    default:
      deviceState = DEVICE_STATE_INIT;
      break;
  }
}
