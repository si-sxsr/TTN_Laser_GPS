// --- WATCHDOG (WDT) CONFIG ---
bool wdt_initialized = false;

void initWatchdog(uint32_t timeout_seconds) {
  NRF_WDT->CONFIG = 0x01; 
  NRF_WDT->CRV = (timeout_seconds * 32768) - 1; 
  NRF_WDT->RREN = 0x01;
  NRF_WDT->TASKS_START = 1;
  Serial.printf("[WDT] Watchdog initialized with %d seconds timeout.\n", timeout_seconds);
}

void feedWatchdog() {
  NRF_WDT->RR[0] = WDT_RR_RR_Reload; // รีเซ็ตตัวนับเวลาของ Watchdog
  Serial.println("[WDT] Watchdog fed!");
}

// --- NMOS Settings ---
#define PIN_POWER_CTL 13
void setSensorPower(bool turnOn) {
  pinMode(PIN_POWER_CTL, OUTPUT);
  if (turnOn) {
    digitalWrite(PIN_POWER_CTL, HIGH);
  } else {
    digitalWrite(PIN_POWER_CTL, LOW);
  }
}

