// --- I2C Helper Functions ---
void writeTo(byte address, byte val) {
  Wire.beginTransmission(ADXL_DEVICE);
  Wire.write(address);
  Wire.write(val);
  Wire.endTransmission();
}

void readFromADXL(byte address, int num, byte _buff[]) {
  Wire.beginTransmission(ADXL_DEVICE);
  Wire.write(address);
  Wire.endTransmission(false);
  Wire.requestFrom(ADXL_DEVICE, (uint8_t)num);
  int i = 0;
  while(Wire.available() && i < num) { _buff[i] = Wire.read(); i++; }
}

bool readTofData() {
  uint8_t pdata[48];
  Wire.beginTransmission(TOF_ADDR);
  Wire.write(0x00);
  if (Wire.endTransmission(false) != 0) return false;
  Wire.requestFrom(TOF_ADDR, 32);
  int i = 0; while (Wire.available()) pdata[i++] = Wire.read();
  
  Wire.beginTransmission(TOF_ADDR);
  Wire.write(0x20);
  if (Wire.endTransmission(false) != 0) return false;
  Wire.requestFrom(TOF_ADDR, 16);
  while (Wire.available()) pdata[i++] = Wire.read();

  tof0.dis = (float)(((uint32_t)pdata[0x24]) | ((uint32_t)pdata[0x25] << 8) | ((uint32_t)pdata[0x26] << 16) | ((uint32_t)pdata[0x27] << 24)) / 1000.0;
  tof0.signal_strength = (uint16_t)(((uint16_t)pdata[0x2a]) | ((uint16_t)pdata[0x2b] << 8));
  return true;
}

uint16_t readBattery() {
  
   pinMode(PIN_BAT_ADC_CTL, OUTPUT);
   digitalWrite(PIN_BAT_ADC_CTL, LOW); 
   delay(50); // รอ 50ms ให้แรงดันไฟนิ่ง

  uint32_t sum = 0;
  Serial.print("5 : "); Serial.println(analogRead(5));
  for (int i = 0; i < 40; i++) {
    sum += analogRead(5); // อ่านค่าอนาลอกจากพิน 5
    delay(10);
  }
  uint32_t adcValue = sum / 40;
  Serial.print("ADC Raw Value (Pin 5): "); Serial.println(adcValue); 
    Serial.print("AR_INTERNAL : ");  Serial.println(AR_INTERNAL); 

  
  digitalWrite(PIN_BAT_ADC_CTL, HIGH);

  // Voltage divider (1/2) จึงต้องคูณ 2 กลับเข้าไป
  uint16_t mv = adcValue * 2; 
  
  return mv;
}

// ===== Prepare LoRaWAN Payload (Total 22 Bytes) =====
void prepareTxFrame(uint8_t port) {
    txCounter++;

    // บังคับเปิดไฟ VEXT เลี้ยงโมดูล GPS / Sensor
    digitalWrite(PIN_VEXT_CTL, VEXT_ENABLE); 
    delay(200); 
    
    // บังคับให้อ่านข้อความ GPS ล่าสุดหลังจากตื่นนอน (ลดเวลาเหลือ 60 วินาทีเพื่อไม่ให้บล็อกระบบนานเกินไป)
    uint32_t waitGPS = millis();
    while (millis() - waitGPS < 60000) {
      while (Serial2.available()) gps.encode(Serial2.read());
    }

    if (gps.location.isValid()) {
      latitude = gps.location.lat();
      longitude = gps.location.lng();
    } else {
      latitude = 0; 
      longitude = 0;
    }

    // อ่านค่า ADXL345 และ TOF
    readFromADXL(0x32, 6, _buff_adxl); 
    bool tofSuccess = readTofData();
    int32_t dis_mm = (int32_t)(tof0.dis * 1000);

    batteryVoltage = readBattery(); 
    Serial.printf("Battery processed: %d mV\n", batteryVoltage);

    appDataSize = 24; 
    int32_t lat_int = (int32_t)(latitude * 1e6);
    int32_t lon_int = (int32_t)(longitude * 1e6);

    // [0-7] GPS Payload
    appData[0] = (lat_int >> 24); appData[1] = (lat_int >> 16); appData[2] = (lat_int >> 8); appData[3] = lat_int;
    appData[4] = (lon_int >> 24); appData[5] = (lon_int >> 16); appData[6] = (lon_int >> 8); appData[7] = lon_int;
    
    // [8-13] ADXL345 Raw Data
    appData[8] = _buff_adxl[1];  appData[9] = _buff_adxl[0];   
    appData[10] = _buff_adxl[3]; appData[11] = _buff_adxl[2];  
    appData[12] = _buff_adxl[5]; appData[13] = _buff_adxl[4];  

    // [14-17] TOF Distance
    appData[14] = (dis_mm >> 24); appData[15] = (dis_mm >> 16); appData[16] = (dis_mm >> 8); appData[17] = dis_mm;

    // [18-19] TOF Signal Strength
    appData[18] = (tof0.signal_strength >> 8); appData[19] = tof0.signal_strength;

    // [20-21] Transmission Count
    appData[20] = (txCounter >> 8); appData[21] = txCounter;

    // [22-23] แพ็กค่า Battery Voltage ที่อ่านได้จริงส่งไปด้วย
    appData[22] = (batteryVoltage >> 8); appData[23] = batteryVoltage;

    // Debug ข้อมูลผ่าน Serial Monitor
    Serial.printf("\n[TX #%d] Lat:%.6f, Lon:%.6f | Dist: %.3f m | Batt: %d mV\n", 
                  txCounter, latitude, longitude, (float)dis_mm/1000.0, batteryVoltage);
    Serial.printf("ADXL Raw -> X:%d, Y:%d, Z:%d\n",
                  (int16_t)((_buff_adxl[1]<<8)|_buff_adxl[0]),
                  (int16_t)((_buff_adxl[3]<<8)|_buff_adxl[2]),
                  (int16_t)((_buff_adxl[5]<<8)|_buff_adxl[4]));
}

void setup() {
  boardInit(LORA_DEBUG_ENABLE, LORA_DEBUG_SERIAL_NUM, 115200);

// ตั้งค่าความละเอียด ADC เป็น 12-bit สำหรับ nRF52
  analogReadResolution(12); 

  analogReference(AR_INTERNAL);

  pinMode(PIN_VEXT_CTL, OUTPUT);
  digitalWrite(PIN_VEXT_CTL, HIGH);
  delay(500);

  Wire.setPins(29, 31);
  Wire.begin();
  Serial2.begin(9600);

  // Init ADXL345
  writeTo(0x31, 0x01); // +/- 4G
  writeTo(0x2D, 0x08); // Measure Mode
  
  MibRequestConfirm_t mibReq;
  mibReq.Type = MIB_RX2_CHANNEL;
  mibReq.Param.Rx2Channel.Frequency = 923200000; // ล็อกความถี่ขารับช่องที่ 2 ไว้ที่ 923.2 MHz (มาตรฐานไทย)
  mibReq.Param.Rx2Channel.Datarate = DR_2;        
  LoRaMacMibSetRequestConfirm(&mibReq);
  Serial.println("[LoRaWAN] RX2 Frequency forced to 923.2 MHz (DR2)");
  // ========================================================

  Serial.println("Wait for GPS fix...");
  deviceState = DEVICE_STATE_INIT;
}

void loop() {

  while (Serial2.available()) gps.encode(Serial2.read());

  switch (deviceState) {
    case DEVICE_STATE_INIT:
      LoRaWAN.init(loraWanClass, loraWanRegion);
      deviceState = DEVICE_STATE_JOIN;
      break;
    case DEVICE_STATE_JOIN:
      LoRaWAN.join();
      break;
    case DEVICE_STATE_SEND:
      prepareTxFrame(appPort);
      LoRaWAN.send();
      deviceState = DEVICE_STATE_CYCLE;
      break;
    case DEVICE_STATE_CYCLE:
      LoRaWAN.cycle(appTxDutyCycle);
      deviceState = DEVICE_STATE_SLEEP;
      break;
    case DEVICE_STATE_SLEEP:
      LoRaWAN.sleep(loraWanClass);
      break;
    default:
      deviceState = DEVICE_STATE_INIT;
      break;
  }
}
